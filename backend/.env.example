# Application Settings
PROJECT_NAME=DIGI-VERSE
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg://digiverse_user:your_db_password_here@localhost:5432/digiverse
# Separate database used ONLY by pytest (name must contain "test"). Tests roll back every change.
TEST_DATABASE_URL=postgresql+psycopg://digiverse_user:your_db_password_here@localhost:5432/digiverse_test
DB_CONNECT_TIMEOUT=5

# JWT Security Configuration
JWT_SECRET_KEY=replace_with_a_strong_64_char_random_hex_secret
ADMIN_JWT_SECRET_KEY=replace_with_a_distinct_64_char_random_hex_secret_for_admin
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_HOURS=12
COOKIE_SECURE=False

# One-Time Initial Administrator Provisioning (Never hardcode or commit real password)
INITIAL_ADMIN_USERNAME=Aayan
INITIAL_ADMIN_EMAIL=aayan@digiverse.internal
INITIAL_ADMIN_PASSWORD=replace_with_initial_admin_password_only_for_one_time_provisioning

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Media & Upload Storage Configuration
UPLOAD_DIR=uploads/images
MAX_IMAGE_UPLOAD_BYTES=5242880

# Private Digital Asset Storage Configuration ("local" or "s3")
ASSET_STORAGE_BACKEND=local
ASSET_STORAGE_LOCAL_ROOT=private_storage/assets
MAX_ASSET_UPLOAD_BYTES=104857600
ASSET_DOWNLOAD_CHUNK_BYTES=65536
ASSET_STORAGE_BUCKET=your_private_asset_bucket_name
ASSET_STORAGE_REGION=auto
ASSET_STORAGE_ENDPOINT_URL=https://your-s3-compatible-endpoint.example.com
ASSET_STORAGE_ACCESS_KEY=your_s3_access_key_placeholder
ASSET_STORAGE_SECRET_KEY=your_s3_secret_key_placeholder
ASSET_STORAGE_USE_PATH_STYLE=True

# Payment Gateway & Digital Delivery Configuration
STORE_CURRENCY=INR
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder
MAX_DOWNLOADS_PER_ORDER_ITEM=5
SIGNED_DOWNLOAD_TOKEN_EXPIRE_SECONDS=300

# Marketing, Email (Resend), WhatsApp Cloud API & Persistent Worker Configuration
OTP_DELIVERY_PROVIDER=development
ENABLE_DEV_OTP=true
WHATSAPP_OTP_ENABLED=false
RESEND_API_KEY=your_resend_api_key_placeholder
RESEND_FROM_EMAIL=noreply@your-domain.example.com
RESEND_FROM_NAME=DIGI-VERSE
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_placeholder
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token_placeholder
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_placeholder
WHATSAPP_GRAPH_API_VERSION=v27.0
WHATSAPP_TEMPLATE_NAME=verification_code
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_REQUEST_TIMEOUT_SECONDS=10.0
WHATSAPP_APP_SECRET=your_meta_app_secret_placeholder
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_placeholder
CAMPAIGN_WORKER_POLL_INTERVAL_SECONDS=30
CAMPAIGN_WORKER_BATCH_SIZE=50
CAMPAIGN_WORKER_STALE_LOCK_SECONDS=300
CAMPAIGN_MAX_RETRY_ATTEMPTS=5
CAMPAIGN_RETRY_BASE_SECONDS=30
CAMPAIGN_RETRY_MAX_BACKOFF_SECONDS=1800
CAMPAIGN_PROVIDER_TIMEOUT_SECONDS=10.0
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
MAX_WEBHOOK_PAYLOAD_BYTES=1048576

# Future Integrations (Placeholders Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder
GOOGLE_DRIVE_CREDENTIALS_PATH=path_to_google_drive_service_account_json
