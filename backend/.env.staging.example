# DIGI-VERSE Staging Backend Environment Template (Placeholders Only — NEVER commit real secrets)
PROJECT_NAME=DIGI-VERSE
ENVIRONMENT=staging
DEBUG=False
API_V1_PREFIX=/api

# Dedicated Staging PostgreSQL Database (NEVER reuse production 'digiverse' or 'digiverse_test')
DATABASE_URL=postgresql+psycopg://digiverse_staging_app:REPLACE_WITH_STRONG_STAGING_DB_PASSWORD@staging-db.example.internal:5432/digiverse_staging?sslmode=require
DB_CONNECT_TIMEOUT=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Distinct Cryptographic Secrets (generate each with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET_CUSTOMER_STAGING
ADMIN_JWT_SECRET_KEY=REPLACE_WITH_DISTINCT_64_CHAR_RANDOM_HEX_SECRET_ADMIN_STAGING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_HOURS=12

# HTTPS Cookie, Proxy & Origin Security
COOKIE_SECURE=True
# Leave COOKIE_DOMAIN unset when frontend proxies /api on the same origin;
# set to parent domain (e.g. .staging.your-domain.example) only if sharing across subdomains.
COOKIE_DOMAIN=
TRUST_PROXY_HEADERS=True
CORS_ORIGINS=["https://staging.your-domain.example"]
ALLOWED_HOSTS=["staging.your-domain.example","api-staging.your-domain.example"]

# Initial Staging Admin Provisioning (rotate immediately after first login)
INITIAL_ADMIN_USERNAME=staging_admin
INITIAL_ADMIN_EMAIL=admin-staging@your-domain.example
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ONE_TIME_STAGING_ADMIN_PASSWORD

# Private S3-Compatible Digital Asset Storage (Private Bucket Only — Zero Public Access)
ASSET_STORAGE_BACKEND=s3
ASSET_STORAGE_BUCKET=digiverse-staging-private-assets
ASSET_STORAGE_REGION=auto
ASSET_STORAGE_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
ASSET_STORAGE_ACCESS_KEY=REPLACE_WITH_R2_OR_S3_ACCESS_KEY_ID
ASSET_STORAGE_SECRET_KEY=REPLACE_WITH_R2_OR_S3_SECRET_ACCESS_KEY
ASSET_STORAGE_USE_PATH_STYLE=True
ASSET_STORAGE_TIMEOUT_SECONDS=60
MAX_ASSET_UPLOAD_BYTES=104857600
ASSET_DOWNLOAD_CHUNK_BYTES=65536
MAX_IMAGE_UPLOAD_BYTES=5242880

# Razorpay Test-Mode Gateway (NEVER use rzp_live_ in staging)
STORE_CURRENCY=INR
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_STAGING_WEBHOOK_SECRET
MAX_DOWNLOADS_PER_ORDER_ITEM=5
SIGNED_DOWNLOAD_TOKEN_EXPIRE_SECONDS=300

# Resend Staging Email Provider
RESEND_API_KEY=re_REPLACE_WITH_STAGING_RESEND_API_KEY
RESEND_FROM_EMAIL=noreply@staging.your-domain.example
RESEND_FROM_NAME=DIGI-VERSE Staging
RESEND_WEBHOOK_SECRET=whsec_REPLACE_WITH_RESEND_STAGING_WEBHOOK_SECRET

# Meta WhatsApp Cloud API Staging Provider
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_TEST_PHONE_NUMBER_ID
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_WHATSAPP_VERIFY_TOKEN

# Persistent Background Campaign Worker
CAMPAIGN_WORKER_POLL_INTERVAL_SECONDS=30
CAMPAIGN_WORKER_BATCH_SIZE=50
CAMPAIGN_WORKER_STALE_LOCK_SECONDS=300
CAMPAIGN_MAX_RETRY_ATTEMPTS=5
CAMPAIGN_RETRY_BASE_SECONDS=30
CAMPAIGN_RETRY_MAX_BACKOFF_SECONDS=1800
CAMPAIGN_PROVIDER_TIMEOUT_SECONDS=10.0
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
MAX_WEBHOOK_PAYLOAD_BYTES=1048576

# Shared Rate Limiter
RATE_LIMIT_USE_DB=True
