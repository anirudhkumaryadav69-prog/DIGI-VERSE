{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://REPLACE-WITH-YOUR-STAGING-API-HOST/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://REPLACE-WITH-YOUR-STAGING-API-HOST/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
