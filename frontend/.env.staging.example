# DIGI-VERSE Frontend Staging Environment Template (No secrets allowed in VITE_* vars)
# Recommended: `/api` when hosted behind same-origin proxy (preserves SameSite=Strict admin cookies).
# If hosted on a separate subdomain sharing parent COOKIE_DOMAIN, use https://api-staging.your-domain.example/api
VITE_API_BASE_URL=/api
VITE_APP_NAME=DIGI-VERSE (Staging)
